# Copia este ficheiro para ".env.local" e preenche com os dados do teu projeto Supabase.
# Estas duas variaveis SAO PUBLICAS (vao para o browser) — nao tem problema nenhum.
# Settings -> API, no painel da Supabase.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# NUNCA ponhas aqui a service_role key. Essa e secreta e neste setup nem e usada.
